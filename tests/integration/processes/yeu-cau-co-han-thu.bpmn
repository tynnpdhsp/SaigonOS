<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="yeu_cau_co_han_thu_dinh_nghia" targetNamespace="https://saigonos.example/bpmn">
  <bpmn:process id="yeu_cau_co_han_thu" name="Yêu cầu có hạn thử" isExecutable="true"
                operaton:historyTimeToLive="P30D" operaton:candidateStarterGroups="nguoi-gui">
    <bpmn:startEvent id="bat_dau" operaton:initiator="nguoi_tao">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="noi_dung" label="Nội dung" type="string">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="ma_yeu_cau" label="Mã yêu cầu" type="string" />
          <operaton:formField id="han_xu_ly" label="Hạn xử lý" type="date">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="luong_1" sourceRef="bat_dau" targetRef="xu_ly" />
    <bpmn:userTask id="xu_ly" name="Xử lý yêu cầu" operaton:candidateGroups="nhan-vien"
                   operaton:dueDate="${han_xu_ly}">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="ket_qua" label="Kết quả" type="string">
            <operaton:validation>
              <operaton:constraint name="required" />
              <operaton:constraint name="minlength" config="10" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="qua_han" name="Quá hạn" attachedToRef="xu_ly">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate>${han_xu_ly}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="luong_2" sourceRef="qua_han" targetRef="xu_ly_qua_han" />
    <bpmn:userTask id="xu_ly_qua_han" name="Xử lý yêu cầu quá hạn" operaton:candidateGroups="quan-ly">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="ket_qua" label="Kết quả" type="string">
            <operaton:validation>
              <operaton:constraint name="required" />
              <operaton:constraint name="minlength" config="10" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="luong_3" sourceRef="xu_ly" targetRef="ghi_ket_qua" />
    <bpmn:sequenceFlow id="luong_4" sourceRef="xu_ly_qua_han" targetRef="ghi_ket_qua" />
    <bpmn:serviceTask id="ghi_ket_qua" name="Ghi kết quả" operaton:type="external"
                      operaton:topic="saigonos-function">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="function" value="thu_nghiem.ghi_ket_qua" />
        </operaton:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="luong_5" sourceRef="ghi_ket_qua" targetRef="ket_thuc" />
    <bpmn:endEvent id="ket_thuc" />
  </bpmn:process>
</bpmn:definitions>
