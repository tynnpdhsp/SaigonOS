<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="dat_phong_dinh_nghia" targetNamespace="https://saigonos.example/phong-may">
  <bpmn:process id="phong_may.dat_phong" name="Đặt phòng máy" isExecutable="true"
                operaton:historyTimeToLive="P180D"
                operaton:candidateStarterGroups="phong-may.giao-vien">
    <bpmn:startEvent id="gui_don" name="Gửi đơn">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="ma_phong" label="Phòng" type="string">
            <operaton:validation>
              <operaton:constraint name="required" />
              <operaton:constraint name="maxlength" config="20" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="bat_dau" label="Bắt đầu" type="date">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="ket_thuc" label="Kết thúc" type="date">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="so_may" label="Số máy cần" type="long">
            <operaton:validation>
              <operaton:constraint name="required" />
              <operaton:constraint name="min" config="1" />
              <operaton:constraint name="max" config="500" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="lop" label="Lớp hoặc học phần" type="string">
            <operaton:validation>
              <operaton:constraint name="required" />
              <operaton:constraint name="maxlength" config="100" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="muc_dich" label="Mục đích" type="enum">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
            <operaton:value id="day_hoc" name="Dạy học" />
            <operaton:value id="thi" name="Thi, kiểm tra" />
          </operaton:formField>
          <operaton:formField id="phan_mem" label="Phần mềm cần cài" type="string">
            <operaton:validation>
              <operaton:constraint name="maxlength" config="1000" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="ghi_chu" label="Ghi chú" type="string">
            <operaton:validation>
              <operaton:constraint name="maxlength" config="1000" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="den_ghi_don" sourceRef="gui_don" targetRef="ghi_don" />
    <bpmn:serviceTask id="ghi_don" name="Kiểm tra và ghi đơn" operaton:type="external"
                      operaton:topic="saigonos-function">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="function" value="phong_may.ghi_don" />
        </operaton:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="den_kiem_tra" sourceRef="ghi_don" targetRef="kiem_tra" />
    <bpmn:exclusiveGateway id="kiem_tra" name="Đơn hợp lệ?" />
    <bpmn:sequenceFlow id="khong_hop_le_luong" name="Không" sourceRef="kiem_tra"
                       targetRef="khong_hop_le">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!hop_le}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="khong_hop_le" name="Đơn không hợp lệ" />
    <bpmn:sequenceFlow id="hop_le_luong" name="Có" sourceRef="kiem_tra" targetRef="duyet">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hop_le}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="duyet" name="Duyệt đơn" operaton:candidateGroups="phong-may.phu-trach"
                   operaton:dueDate="${han_duyet}">
      <bpmn:documentation>Đơn đặt phòng số ${ma_don}</bpmn:documentation>
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="ket_qua" label="Kết quả" type="enum">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
            <operaton:value id="dong_y" name="Đồng ý" />
            <operaton:value id="tu_choi" name="Từ chối" />
          </operaton:formField>
          <operaton:formField id="y_kien" label="Ý kiến" type="string">
            <operaton:validation>
              <operaton:constraint name="maxlength" config="1000" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="qua_han" name="Quá hạn duyệt" attachedToRef="duyet"
                        cancelActivity="false">
      <bpmn:timerEventDefinition id="qua_han_hen_gio">
        <bpmn:timeDate>${han_duyet}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="den_nhac_duyet" sourceRef="qua_han" targetRef="nhac_duyet" />
    <bpmn:serviceTask id="nhac_duyet" name="Nhắc phụ trách phòng" operaton:type="external"
                      operaton:topic="saigonos-function">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="function" value="phong_may.nhac_duyet" />
        </operaton:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="den_da_nhac" sourceRef="nhac_duyet" targetRef="da_nhac" />
    <bpmn:endEvent id="da_nhac" name="Đã nhắc" />
    <bpmn:sequenceFlow id="den_ghi_ket_qua" sourceRef="duyet" targetRef="ghi_ket_qua" />
    <bpmn:serviceTask id="ghi_ket_qua" name="Ghi kết quả duyệt" operaton:type="external"
                      operaton:topic="saigonos-function">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="function" value="phong_may.ghi_ket_qua" />
        </operaton:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="den_kiem_duyet" sourceRef="ghi_ket_qua" targetRef="kiem_duyet" />
    <bpmn:exclusiveGateway id="kiem_duyet" name="Đơn được duyệt?" />
    <bpmn:sequenceFlow id="tu_choi_luong" name="Không" sourceRef="kiem_duyet"
                       targetRef="bi_tu_choi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!da_duyet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="bi_tu_choi" name="Đơn bị từ chối" />
    <bpmn:sequenceFlow id="duoc_duyet_luong" name="Có" sourceRef="kiem_duyet" targetRef="chuan_bi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${da_duyet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="chuan_bi" name="Chuẩn bị phòng"
                   operaton:candidateGroups="phong-may.chuyen-vien" operaton:dueDate="${bat_dau}">
      <bpmn:documentation>Đơn đặt phòng số ${ma_don}</bpmn:documentation>
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="so_may_san_sang" label="Số máy sẵn sàng" type="long">
            <operaton:validation>
              <operaton:constraint name="required" />
              <operaton:constraint name="min" config="0" />
              <operaton:constraint name="max" config="500" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="ghi_chu_chuan_bi" label="Ghi chú chuẩn bị" type="string">
            <operaton:validation>
              <operaton:constraint name="maxlength" config="1000" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="den_ghi_san_sang" sourceRef="chuan_bi" targetRef="ghi_san_sang" />
    <bpmn:serviceTask id="ghi_san_sang" name="Ghi phòng sẵn sàng" operaton:type="external"
                      operaton:topic="saigonos-function">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="function" value="phong_may.ghi_san_sang" />
        </operaton:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="den_san_sang" sourceRef="ghi_san_sang" targetRef="san_sang" />
    <bpmn:endEvent id="san_sang" name="Phòng đã sẵn sàng" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="hinh_dat_phong">
    <bpmndi:BPMNPlane id="mat_phang_dat_phong" bpmnElement="phong_may.dat_phong">
      <bpmndi:BPMNShape id="gui_don_hinh" bpmnElement="gui_don">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="148" y="225" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ghi_don_hinh" bpmnElement="ghi_don">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kiem_tra_hinh" bpmnElement="kiem_tra" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="386" y="151" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khong_hop_le_hinh" bpmnElement="khong_hop_le">
        <dc:Bounds x="402" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="376" y="345" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="duyet_hinh" bpmnElement="duyet">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="qua_han_hinh" bpmnElement="qua_han">
        <dc:Bounds x="532" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="572" y="262" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nhac_duyet_hinh" bpmnElement="nhac_duyet">
        <dc:Bounds x="500" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="da_nhac_hinh" bpmnElement="da_nhac">
        <dc:Bounds x="652" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="365" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ghi_ket_qua_hinh" bpmnElement="ghi_ket_qua">
        <dc:Bounds x="660" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kiem_duyet_hinh" bpmnElement="kiem_duyet" isMarkerVisible="true">
        <dc:Bounds x="815" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="796" y="151" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bi_tu_choi_hinh" bpmnElement="bi_tu_choi">
        <dc:Bounds x="822" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="803" y="345" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chuan_bi_hinh" bpmnElement="chuan_bi">
        <dc:Bounds x="920" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ghi_san_sang_hinh" bpmnElement="ghi_san_sang">
        <dc:Bounds x="1080" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="san_sang_hinh" bpmnElement="san_sang">
        <dc:Bounds x="1232" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1204" y="225" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="den_ghi_don_hinh" bpmnElement="den_ghi_don">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_kiem_tra_hinh" bpmnElement="den_kiem_tra">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="khong_hop_le_luong_hinh" bpmnElement="khong_hop_le_luong">
        <di:waypoint x="420" y="225" />
        <di:waypoint x="420" y="302" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="256" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="hop_le_luong_hinh" bpmnElement="hop_le_luong">
        <di:waypoint x="445" y="200" />
        <di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="463" y="182" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_nhac_duyet_hinh" bpmnElement="den_nhac_duyet">
        <di:waypoint x="550" y="258" />
        <di:waypoint x="550" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_da_nhac_hinh" bpmnElement="den_da_nhac">
        <di:waypoint x="600" y="340" />
        <di:waypoint x="652" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_ghi_ket_qua_hinh" bpmnElement="den_ghi_ket_qua">
        <di:waypoint x="600" y="200" />
        <di:waypoint x="660" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_kiem_duyet_hinh" bpmnElement="den_kiem_duyet">
        <di:waypoint x="760" y="200" />
        <di:waypoint x="815" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tu_choi_luong_hinh" bpmnElement="tu_choi_luong">
        <di:waypoint x="840" y="225" />
        <di:waypoint x="840" y="302" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="848" y="256" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="duoc_duyet_luong_hinh" bpmnElement="duoc_duyet_luong">
        <di:waypoint x="865" y="200" />
        <di:waypoint x="920" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="883" y="182" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_ghi_san_sang_hinh" bpmnElement="den_ghi_san_sang">
        <di:waypoint x="1020" y="200" />
        <di:waypoint x="1080" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="den_san_sang_hinh" bpmnElement="den_san_sang">
        <di:waypoint x="1180" y="200" />
        <di:waypoint x="1232" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
