{
  "name": "operaton",
  "desc": "Operaton: Cockpit, Tasklist và Admin, đăng nhập bằng Keycloak. OPA kiểm tra dải IP trước khi chuyển lời gọi. REST của Operaton không mở qua API Gateway. Nút đăng xuất của Operaton trỏ tới /operaton/logout",
  "uris": [
    "/operaton",
    "/operaton/",
    "/operaton/app/*",
    "/operaton/api/*",
    "/operaton/assets/*",
    "/operaton/lib/*",
    "/operaton/favicon.ico",
    "/operaton/oauth2/authorization/operaton",
    "/operaton/login/oauth2/code/operaton",
    "/operaton/logout"
  ],
  "vars": [["uri", "!", "~~", ";"]],
  "plugins": {
    "opa": {
      "host": "http://opa:8181",
      "policy": "saigonos/admin/decision"
    },
    "proxy-rewrite": {
      "regex_uri": ["^(.*)$", "$1"]
    }
  },
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "operaton:8080": 1
    }
  }
}
