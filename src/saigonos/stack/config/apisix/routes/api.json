{
  "name": "api",
  "desc": "PostgREST: API dữ liệu của schema api, kiểm tra access token khi lời gọi có header Authorization và giới hạn tần suất theo địa chỉ IP. API của ứng dụng chỉ nằm ở route app-<tên>",
  "uris": ["/api", "/api/*"],
  "plugins": {
    "openid-connect": {
      "_meta": {
        "filter": [["http_authorization", "~~", "."]]
      },
      "client_id": "apisix",
      "discovery": "http://keycloak:8080/auth/realms/saigonos/.well-known/openid-configuration",
      "realm": "saigonos",
      "bearer_only": true,
      "use_jwks": true,
      "iat_slack": 0
    },
    "limit-count": {
      "count": 300,
      "time_window": 10,
      "key_type": "var",
      "key": "remote_addr",
      "rejected_code": 429,
      "rejected_msg": "Gọi API quá nhiều lần, vui lòng thử lại sau"
    },
    "proxy-rewrite": {
      "regex_uri": ["^/api/?(.*)$", "/$1"],
      "headers": {
        "set": {
          "Accept-Profile": "api",
          "Content-Profile": "api"
        }
      }
    }
  },
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "postgrest:3000": 1
    }
  }
}
