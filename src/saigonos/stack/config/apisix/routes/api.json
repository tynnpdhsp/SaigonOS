{
  "name": "api",
  "desc": "PostgREST: API dữ liệu, yêu cầu access token và giới hạn tần suất theo địa chỉ IP",
  "uris": ["/api", "/api/*"],
  "plugins": {
    "openid-connect": {
      "client_id": "apisix",
      "discovery": "http://keycloak:8080/auth/realms/saigonos/.well-known/openid-configuration",
      "realm": "saigonos",
      "bearer_only": true,
      "use_jwks": true,
      "iat_slack": 0
    },
    "limit-count": {
      "count": 300,
      "time_window": 10,
      "key_type": "var",
      "key": "remote_addr",
      "rejected_code": 429,
      "rejected_msg": "Gọi API quá nhiều lần, vui lòng thử lại sau"
    },
    "proxy-rewrite": {
      "regex_uri": ["^/api/?(.*)$", "/$1"]
    }
  },
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "postgrest:3000": 1
    }
  }
}
