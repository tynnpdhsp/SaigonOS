{
  "name": "auth",
  "desc": "Keycloak: đăng nhập và quản lý tài khoản. Realm master chỉ mở trên máy cài đặt",
  "uris": ["/auth", "/auth/*"],
  "vars": [["uri", "!", "~~", "^/auth/(realms|admin|admin/realms)/master(/.*)?$"]],
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "keycloak:8080": 1
    }
  }
}
