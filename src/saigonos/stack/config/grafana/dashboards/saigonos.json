{
  "uid": "saigonos",
  "title": "SaigonOS",
  "tags": ["saigonos"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service)",
        "definition": "label_values(service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": "All", "value": "$__all"},
        "sort": 1
      },
      {
        "name": "search",
        "label": "Tìm trong log",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request",
      "description": "Số request qua API Gateway trong khoảng thời gian đang xem, không tính request tới Grafana",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "round(increase(saigonos:http_requests:total[$__range]))", "instant": true, "range": false}],
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lỗi 4xx",
      "description": "Số request nhận mã 4xx, gồm cả request bị WAF chặn và bị OPA từ chối",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "round(increase(saigonos:http_client_errors:total[$__range]))", "instant": true, "range": false}],
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lỗi 5xx",
      "description": "Số request nhận mã 5xx",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "round(increase(saigonos:http_server_errors:total[$__range]))", "instant": true, "range": false}],
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bị WAF chặn",
      "description": "Số request bị tường lửa ứng dụng web Coraza chặn",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "round(increase(saigonos:waf_denied:total[$__range]))", "instant": true, "range": false}],
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Bị OPA từ chối",
      "description": "Số request bị luật truy cập của OPA từ chối",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "round(increase(saigonos:opa_denied:total[$__range]))", "instant": true, "range": false}],
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RAM",
      "description": "Tổng RAM của các container đang chạy",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(saigonos_service_memory_bytes)", "instant": true, "range": false}],
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Service",
      "description": "Service chạy lâu dài, trạng thái theo healthcheck và RAM hiện tại",
      "gridPos": {"x": 0, "y": 4, "w": 9, "h": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (service) (saigonos_service_up)", "instant": true, "range": false, "format": "table"},
        {"refId": "B", "expr": "sum by (service) (saigonos_service_memory_bytes)", "instant": true, "range": false, "format": "table"}
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "indexByName": {"service": 0, "Value #A": 1, "Value #B": 2},
            "renameByName": {"service": "Service", "Value #A": "Trạng thái", "Value #B": "RAM"}
          }
        }
      ],
      "options": {"showHeader": true, "cellHeight": "sm", "sortBy": [{"displayName": "Service", "desc": false}]},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Trạng thái"},
            "properties": [
              {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Không chạy", "color": "red"}, "1": {"text": "Đang chạy", "color": "green"}}}]},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          },
          {"matcher": {"id": "byName", "options": "RAM"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 0}]}
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request theo mã trạng thái",
      "description": "Số request mỗi giây qua API Gateway, tách theo mã trạng thái",
      "gridPos": {"x": 9, "y": 4, "w": 15, "h": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (code) (rate(apisix_http_status{route!=\"grafana\"}[$__rate_interval]))", "legendFormat": "{{code}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "gradientMode": "none", "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Log",
      "description": "Log của các service. Chọn service và gõ chữ cần tìm ở đầu trang. Ví dụ: chọn apisix và tìm Coraza để xem request bị WAF chặn",
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 14},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service=~\"$service\"} |~ \"(?i)$search\""}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none"}
    }
  ]
}
