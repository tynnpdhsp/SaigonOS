{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AccessRule": {
      "additionalProperties": false,
      "properties": {
        "methods": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "GET",
                  "POST",
                  "PATCH",
                  "PUT",
                  "DELETE"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Các phương thức HTTP mà luật áp dụng. GET áp dụng cả cho HEAD. Khi không khai, luật áp dụng cho mọi phương thức."
        },
        "paths": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "pattern": "^/[A-Za-z0-9_.*/-]*$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Các đường dẫn mà luật áp dụng, tính từ /apps/<tên ứng dụng>/api, theo cú pháp glob. Dấu * khớp với một cấp, dấu ** khớp với nhiều cấp. Khi không khai, luật áp dụng cho mọi đường dẫn."
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Người gọi phải có ít nhất một trong các role này của ứng dụng."
        },
        "networks": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Địa chỉ IP của người gọi phải thuộc một trong các dải mạng này, viết theo dạng CIDR. Ví dụ: 192.168.1.0/24."
        },
        "otp": {
          "default": false,
          "description": "Người gọi phải đăng nhập bằng mật khẩu và mã OTP.",
          "type": "boolean"
        }
      },
      "title": "AccessRule",
      "type": "object"
    },
    "ArchiveTable": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "description": "Tên bảng trong schema của ứng dụng. Ví dụ: don_nghi.",
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "column": {
          "description": "Cột thời gian của dòng, có kiểu timestamptz, timestamp hoặc date. Ví dụ: tao_luc.",
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "keep_days": {
          "description": "Số ngày dòng được giữ ở bảng. Dòng cũ hơn được chuyển xuống hồ dữ liệu.",
          "maximum": 36500,
          "minimum": 1,
          "type": "integer"
        },
        "rules": {
          "description": "Luật chất lượng mà các dòng cũ phải đạt trước khi được chuyển xuống hồ.",
          "items": {
            "discriminator": {
              "mapping": {
                "not_null": "#/$defs/NotNullRule",
                "range": "#/$defs/RangeRule",
                "unique": "#/$defs/UniqueRule"
              },
              "propertyName": "rule"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NotNullRule"
              },
              {
                "$ref": "#/$defs/UniqueRule"
              },
              {
                "$ref": "#/$defs/RangeRule"
              }
            ]
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "table",
        "column",
        "keep_days"
      ],
      "title": "ArchiveTable",
      "type": "object"
    },
    "NotNullRule": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "not_null",
          "description": "Các cột phải có giá trị ở mọi dòng.",
          "type": "string"
        },
        "columns": {
          "description": "Các cột không được có giá trị NULL.",
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "rule",
        "columns"
      ],
      "title": "NotNullRule",
      "type": "object"
    },
    "RangeRule": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "range",
          "description": "Giá trị của cột phải nằm trong khoảng.",
          "type": "string"
        },
        "column": {
          "description": "Cột kiểu số cần kiểm. Dòng có cột rỗng không bị tính là vi phạm.",
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Giá trị nhỏ nhất được phép."
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Giá trị lớn nhất được phép."
        }
      },
      "required": [
        "rule",
        "column"
      ],
      "title": "RangeRule",
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Tên realm role, có dạng <tên ứng dụng>.<vai trò>. Ví dụ: nghi-phep.quan-ly.",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "description": {
          "description": "Mô tả của role.",
          "maxLength": 255,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "Role",
      "type": "object"
    },
    "SearchTable": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "description": "Tên bảng trong schema của ứng dụng. Ví dụ: don_nghi.",
          "maxLength": 47,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "columns": {
          "description": "Các cột cần tìm. Mỗi cột có kiểu text, varchar hoặc char.",
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "table",
        "columns"
      ],
      "title": "SearchTable",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "view": {
          "description": "Tên view hoặc bảng trong schema của ứng dụng. Ví dụ: chot_don.",
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "column": {
          "description": "Cột thời gian của dòng, có kiểu timestamptz, timestamp hoặc date. Lõi dùng cột này để chia các dòng theo tháng.",
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "rules": {
          "description": "Luật chất lượng mà các dòng của tháng phải đạt trước khi được chốt.",
          "items": {
            "discriminator": {
              "mapping": {
                "not_null": "#/$defs/NotNullRule",
                "range": "#/$defs/RangeRule",
                "unique": "#/$defs/UniqueRule"
              },
              "propertyName": "rule"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NotNullRule"
              },
              {
                "$ref": "#/$defs/UniqueRule"
              },
              {
                "$ref": "#/$defs/RangeRule"
              }
            ]
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "view",
        "column"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "UniqueRule": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "unique",
          "description": "Không có hai dòng trùng mã.",
          "type": "string"
        },
        "columns": {
          "description": "Các cột tạo thành mã. Hai dòng không được trùng giá trị ở mọi cột này. Dòng có cột rỗng không được tính.",
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "rule",
        "columns"
      ],
      "title": "UniqueRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Nội dung của file saigonos-app.json.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Địa chỉ JSON Schema của bản khai. Trình soạn thảo dùng địa chỉ này để kiểm tra và gợi ý khi viết bản khai."
    },
    "name": {
      "description": "Tên ứng dụng, gồm các cụm chữ thường không dấu và chữ số nối với nhau bằng một dấu gạch ngang, bắt đầu bằng chữ cái. Ví dụ: nghi-phep.",
      "maxLength": 32,
      "not": {
        "anyOf": [
          {
            "enum": [
              "account",
              "account-console",
              "admin-cli",
              "anon",
              "api",
              "apps",
              "auth",
              "auth-admin",
              "authenticated",
              "authenticator",
              "broker",
              "centrifugo",
              "core",
              "core-service",
              "grafana",
              "information-schema",
              "keycloak",
              "operaton",
              "postgres",
              "public",
              "realm-management",
              "realtime",
              "saigonos",
              "security-admin-console",
              "workflow"
            ]
          },
          {
            "pattern": "^pg-"
          }
        ]
      },
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "title": {
      "description": "Tên hiển thị của ứng dụng.",
      "maxLength": 100,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
      "type": "string"
    },
    "version": {
      "description": "Phiên bản của ứng dụng theo Semantic Versioning, ví dụ 1.0.0.",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    },
    "roles": {
      "description": "Các realm role của ứng dụng.",
      "items": {
        "$ref": "#/$defs/Role"
      },
      "minItems": 1,
      "type": "array"
    },
    "database": {
      "anyOf": [
        {
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Thư mục chứa file SQL, tính từ thư mục ứng dụng."
    },
    "processes": {
      "anyOf": [
        {
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Thư mục chứa file BPMN, tính từ thư mục ứng dụng."
    },
    "ui": {
      "anyOf": [
        {
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Thư mục chứa giao diện, tính từ thư mục ứng dụng. Thư mục phải có file index.html."
    },
    "access": {
      "description": "Các luật truy cập API của ứng dụng. OPA kiểm tra các luật này ở API Gateway. Lời gọi khớp phương thức và đường dẫn của một luật phải đạt mọi điều kiện của luật.",
      "items": {
        "$ref": "#/$defs/AccessRule"
      },
      "maxItems": 20,
      "type": "array"
    },
    "search": {
      "description": "Các bảng cần tìm kiếm toàn văn. Khi cài đặt, lõi tạo index GIN và hàm search_<bảng> cho mỗi bảng. Hàm này tìm không phân biệt có dấu hay không dấu.",
      "items": {
        "$ref": "#/$defs/SearchTable"
      },
      "maxItems": 20,
      "type": "array"
    },
    "archive": {
      "description": "Các bảng có dòng cũ được chuyển xuống hồ dữ liệu. Mỗi giờ, lõi chuyển các dòng cũ hơn keep_days ngày sang file Parquet rồi xóa các dòng này khỏi bảng.",
      "items": {
        "$ref": "#/$defs/ArchiveTable"
      },
      "maxItems": 20,
      "type": "array"
    },
    "snapshots": {
      "description": "Các view hoặc bảng được chốt số liệu theo tháng. Khi một tháng kết thúc, lõi ghi các dòng của tháng đó vào một file Parquet không bị ghi đè.",
      "items": {
        "$ref": "#/$defs/Snapshot"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "name",
    "title",
    "version",
    "roles"
  ],
  "title": "Bản khai ứng dụng SaigonOS",
  "type": "object"
}
